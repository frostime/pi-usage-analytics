{
  "name": "@frostime/pi-usage-analytics",
  "author": {
    "name": "frostime",
    "url": "https://github.com/frostime"
  },
  "version": "0.2.0",
  "description": "Tracing and usage analytics for Pi, covering provider/model, directory, timeline, history import, and safe daily compaction.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frostime/pi-usage-analytics.git"
  },
  "homepage": "https://github.com/frostime/pi-usage-analytics#readme",
  "bugs": {
    "url": "https://github.com/frostime/pi-usage-analytics/issues"
  },
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "usage",
    "analytics",
    "tokens",
    "cost",
    "sqlite"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "pack:dry": "npm pack --dry-run",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
